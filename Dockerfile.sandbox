# =============================================================================
# RLM Sandbox Docker Image
# =============================================================================
# Dieses Image bietet eine sichere, isolierte Python-Umgebung fuer die
# RLM REPL-Ausfuehrung.
#
# Build: docker build -t rlm-sandbox -f Dockerfile.sandbox .
# =============================================================================

FROM python:3.11-slim

# Metadaten
LABEL maintainer="RLM Team"
LABEL description="Secure Python sandbox for RLM REPL execution"
LABEL version="1.0"

# Sicherheit: Kein Root-Benutzer
# Erstelle einen unprivilegierten Benutzer
RUN groupadd -r rlm && useradd -r -g rlm -d /workspace -s /sbin/nologin rlm

# Minimale Paketinstallation
# Nur die absolut notwendigen Pakete
RUN apt-get update && apt-get install -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Python-Abhaengigkeiten
# Nur die fuer die REPL notwendigen Pakete
RUN pip install --no-cache-dir \
    dill>=0.3.7 \
    requests>=2.31.0

# Erstelle Arbeitsverzeichnis
RUN mkdir -p /workspace && chown -R rlm:rlm /workspace

# Arbeitsverzeichnis setzen
WORKDIR /workspace

# Benutzer wechseln (weg von root)
USER rlm

# Umgebungsvariablen
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV HOME=/workspace

# Healthcheck
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD python -c "print('OK')" || exit 1

# Standard-Befehl: Keep container running
CMD ["tail", "-f", "/dev/null"]
